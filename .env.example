# Development only. Replace credentials for an existing PostgreSQL server.
POSTGRES_DB=rps_auth
POSTGRES_USER=rps_auth
POSTGRES_PASSWORD=local_dev_password
# Host port 5433 avoids clashing with a local PostgreSQL on 5432.
# 127.0.0.1 avoids Windows resolving localhost to IPv6 ::1.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://rps_auth:local_dev_password@127.0.0.1:5433/rps_auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required for login and authenticated endpoints; never commit your actual secret.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

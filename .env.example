# Development only. Replace credentials for an existing PostgreSQL server.
POSTGRES_DB=rps_auth
POSTGRES_USER=rps_auth
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rps_auth:local_dev_password@localhost:5432/rps_auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required for login and authenticated endpoints; never commit your actual secret.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
